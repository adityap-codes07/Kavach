{
  "manifest_version": 3,
  "name": "Kavach — Email Security",
  "version": "1.0.0",
  "description": "Context-aware email threat detection using BERT and Explainable AI.",
  "author": "Kavach Research Team",
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Kavach — Scan Email"
  },
  "background": {
    "service_worker": "src/background/service_worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*",
        "https://outlook.live.com/*",
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*",
        "https://mail.yahoo.com/*",
        "https://mail.proton.me/*"
      ],
      "js": [
        "src/content/content_script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "clipboardRead",
    "notifications"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://mail.google.com/*",
    "https://outlook.live.com/*",
    "https://outlook.office.com/*",
    "https://mail.yahoo.com/*",
    "https://mail.proton.me/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http://localhost:8000 http://127.0.0.1:8000;"
  },
  "minimum_chrome_version": "102"
}